                "x": 0.42,
                "pose": "type",
                "face": "worried",
                "emote": "sweat",
                "emoteAt": "forty"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "name",
      "say": "There's a name for this: *Parkinson's law.*",
      "visual": {
        "type": "quote",
        "text": "PARKINSON'S LAW",
        "sub": "“Work expands so as to fill the time available.” — C. N. Parkinson, 1955",
        "person": {
          "pose": "think",
          "face": "smug"
        }
      }
    },
    {
      "id": "joke",
      "say": "It's not even a real law. It began as a *joke* in [1955.|nineteen fifty-five.]",
      "visual": {
        "type": "situation",
        "setting": "room",
        "props": [
          {
            "type": "lamp",
            "x": 0.85
          }
        ],
        "people": [
          {
            "x": 0.45,
            "pose": "phone",
            "holding": "book",
            "face": "smug",
            "gaze": 0.3,
            "then": [
              {
                "at": "joke",
                "face": "grin"
              }
            ],
            "emote": "!?",
            "emoteAt": "joke"
          }
        ],
        "notes": [
          {
            "kind": "circle",
            "target": "head:0",
            "at": "real"
          }
        ]
      }
    },
    {
