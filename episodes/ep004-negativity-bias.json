    {
      "id": "name",
      "say": "Psychologists call it the *negativity bias*. Bad things simply weigh more than good ones.",
      "transition": "cut",
      "hold": 0.5,
      "visual": {
        "type": "page",
        "camera": [
          {
            "panel": "title",
            "secs": 1.3
          },
          {
            "at": "bad",
            "panel": "scale",
            "secs": 1.3
          }
        ],
        "events": {
          "weigh": "weigh"
        }
      }
    },
    {
      "id": "brain",
      "say": "You can even see it in brain waves. Unpleasant pictures triggered a *bigger* response than pleasant ones, even when both were equally intense.",
      "transition": "cut",
      "hold": 0.5,
      "visual": {
        "type": "page",
        "camera": [
          {
            "panel": "study",
            "secs": 1.3
